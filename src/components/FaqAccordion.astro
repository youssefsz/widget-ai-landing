---
interface FaqItem {
  readonly question: string
  readonly answer: string
}

interface Props {
  items: readonly FaqItem[]
}

const { items } = Astro.props
---

<div
  class="border-t border-border/60 lg:col-span-7 lg:col-start-6"
  data-faq-accordion
>
  {
    items.map((item, index) => {
      const triggerId = `faq-trigger-${index + 1}`
      const panelId = `faq-panel-${index + 1}`
      const initiallyOpen = index === 0

      return (
        <div
          class="faq-item border-b border-border/60"
          data-open={String(initiallyOpen)}
        >
          <h3>
            <button
              id={triggerId}
              type="button"
              class="flex w-full cursor-pointer items-center justify-between gap-6 py-6 text-left text-base font-semibold text-foreground outline-none hover:text-primary focus-visible:text-primary sm:py-7 sm:text-lg"
              aria-expanded={initiallyOpen}
              aria-controls={panelId}
              data-faq-trigger
            >
              <span>{item.question}</span>
              <span
                class="faq-plus relative h-5 w-5 shrink-0 text-muted-foreground"
                aria-hidden="true"
              >
                <span class="absolute top-1/2 left-1/2 h-px w-4 bg-current" />
                <span class="absolute top-1/2 left-1/2 h-4 w-px bg-current" />
              </span>
            </button>
          </h3>

          <div
            id={panelId}
            class="faq-answer-grid"
            aria-hidden={!initiallyOpen}
            aria-labelledby={triggerId}
            data-faq-panel
          >
            <div class="faq-answer-inner">
              <div class="max-w-2xl pb-7 text-sm leading-7 text-muted-foreground sm:pr-12 sm:text-base">
                {item.answer}
              </div>
            </div>
          </div>
        </div>
      )
    })
  }
</div>

<script>
  document
    .querySelectorAll<HTMLElement>("[data-faq-accordion]")
    .forEach((accordion) => {
      accordion
        .querySelectorAll<HTMLButtonElement>("[data-faq-trigger]")
        .forEach((trigger) => {
          trigger.addEventListener("click", () => {
            const item = trigger.closest<HTMLElement>(".faq-item")
            const panel = item?.querySelector<HTMLElement>("[data-faq-panel]")

            if (!item || !panel) return

            const nextOpen = item.dataset.open !== "true"
            item.dataset.open = String(nextOpen)
            trigger.setAttribute("aria-expanded", String(nextOpen))
            panel.setAttribute("aria-hidden", String(!nextOpen))
          })
        })
    })
</script>
