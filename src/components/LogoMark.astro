---
interface Props {
  size?: number
  color?: string
  class?: string
}

const { size = 28, color = "var(--primary)", class: className } = Astro.props
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  aria-hidden="true"
>
  <path
    d="M10 5h28a6 6 0 0 1 6 6v20a6 6 0 0 1-6 6H18l-8 7v-7a6 6 0 0 1-6-6V11a6 6 0 0 1 6-6Z"
    stroke={color}
    stroke-width="3.2"
    stroke-linejoin="round"></path>
  <path
    d="M19 15c.7 3.6 2.4 5.3 6 6-3.6.7-5.3 2.4-6 6-.7-3.6-2.4-5.3-6-6 3.6-.7 5.3-2.4 6-6Z"
    fill={color}></path>
  <path
    d="M31 10c.4 2 1.4 3 3.4 3.4-2 .4-3 1.4-3.4 3.4-.4-2-1.4-3-3.4-3.4 2-.4 3-1.4 3.4-3.4Z"
    fill={color}></path>
</svg>
