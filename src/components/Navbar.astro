---
import { Image } from "astro:assets"
import LinkButton from "@/components/ui/LinkButton.astro"
import { buttonVariants } from "@/components/ui/button-variants"
import logoImage from "@/assets/logo.png"
import { siteConfig } from "@/lib/site"
import "@/styles/components/navbar.css"
---

<header
  class="site-navbar fixed inset-x-0 top-0 z-50 border-b border-border/45 bg-background"
>
  <div
    class="mx-auto flex h-16 max-w-7xl items-center justify-between px-5 sm:px-6 lg:px-8"
  >
    <a
      href="/"
      class="flex min-h-11 items-center rounded-sm outline-none hover:opacity-80 focus-visible:ring-2 focus-visible:ring-primary"
      aria-label="WidgetAI home"
    >
      <Image
        src={logoImage}
        alt="WidgetAI"
        width={154}
        height={40}
        class="h-7 w-auto"
      />
    </a>

    <nav
      class="hidden items-center gap-7 text-[0.82rem] font-medium text-muted-foreground lg:flex"
      aria-label="Primary navigation"
    >
      <a class="nav-link" href="#product">Product</a>
      <a class="nav-link" href="#how-it-works">How it works</a>
      <a class="nav-link" href="#features">Control</a>
      <a class="nav-link" href="#faq">FAQ</a>
    </nav>

    <div class="hidden items-center gap-5 lg:flex">
      <a
        href={siteConfig.dashboardUrl}
        class="text-[0.82rem] font-medium text-muted-foreground hover:text-foreground"
      >
        Sign in
      </a>
      <LinkButton href={siteConfig.dashboardUrl} size="sm">
        Create a widget
        <svg
          aria-hidden="true"
          viewBox="0 0 16 16"
          fill="none"
          class="h-3.5 w-3.5"
        >
          <path
            d="M3.5 8h9m-3.25-3.25L12.5 8l-3.25 3.25"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </LinkButton>
    </div>

    <button
      id="mobile-menu-toggle"
      type="button"
      class={buttonVariants({
        variant: "outline",
        size: "icon",
        className: "lg:hidden",
      })}
      aria-expanded="false"
      aria-controls="mobile-navigation"
      aria-label="Open navigation"
    >
      <svg
        data-menu-icon
        aria-hidden="true"
        viewBox="0 0 20 20"
        fill="none"
        class="h-5 w-5"
      >
        <path
          d="M3 5.5h14M3 10h14M3 14.5h14"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"></path>
      </svg>
      <svg
        data-close-icon
        aria-hidden="true"
        viewBox="0 0 20 20"
        fill="none"
        class="hidden h-5 w-5"
      >
        <path
          d="M5 5l10 10M15 5 5 15"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"></path>
      </svg>
    </button>
  </div>

  <div id="mobile-navigation" class="hidden lg:hidden">
    <button
      data-menu-backdrop
      type="button"
      class="fixed inset-0 top-16 z-0 cursor-default bg-background/90"
      aria-label="Close navigation"></button>
    <nav
      class="relative z-10 border-y border-border/70 bg-background"
      aria-label="Mobile navigation"
    >
      <div class="flex flex-col p-2">
        <a class="mobile-nav-link" href="#product">Product</a>
        <a class="mobile-nav-link" href="#how-it-works">How it works</a>
        <a class="mobile-nav-link" href="#features">Control</a>
        <a class="mobile-nav-link" href="#faq">FAQ</a>
      </div>
      <div class="grid grid-cols-2 gap-2 border-t border-border/55 p-3">
        <LinkButton href={siteConfig.dashboardUrl} variant="outline" size="md">
          Sign in
        </LinkButton>
        <LinkButton href={siteConfig.dashboardUrl} size="md">
          Create widget
        </LinkButton>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(
    "#mobile-menu-toggle"
  )
  const navigation = document.querySelector<HTMLElement>("#mobile-navigation")
  const backdrop = navigation?.querySelector<HTMLButtonElement>(
    "[data-menu-backdrop]"
  )
  const menuIcon = toggle?.querySelector<SVGElement>("[data-menu-icon]")
  const closeIcon = toggle?.querySelector<SVGElement>("[data-close-icon]")
  const mobileLinks = navigation?.querySelectorAll<HTMLAnchorElement>("a")

  const setMenuOpen = (open: boolean) => {
    if (!toggle || !navigation) return

    toggle.setAttribute("aria-expanded", String(open))
    toggle.setAttribute(
      "aria-label",
      open ? "Close navigation" : "Open navigation"
    )
    navigation.classList.toggle("hidden", !open)
    menuIcon?.classList.toggle("hidden", open)
    closeIcon?.classList.toggle("hidden", !open)
    document.documentElement.classList.toggle("overflow-hidden", open)
  }

  toggle?.addEventListener("click", () => {
    setMenuOpen(toggle.getAttribute("aria-expanded") !== "true")
  })
  backdrop?.addEventListener("click", () => setMenuOpen(false))
  mobileLinks?.forEach((link) =>
    link.addEventListener("click", () => setMenuOpen(false))
  )
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") setMenuOpen(false)
  })
</script>
