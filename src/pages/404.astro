---
import Layout from "@/layouts/main.astro"
import LogoMark from "@/components/LogoMark.astro"
import { siteConfig } from "@/lib/site"
---

<Layout
  title="Page not found"
  description="The page you requested could not be found. Return to the WidgetAI homepage or contact support."
  canonicalPath="/404"
  noindex={true}
>
  <main class="nf">
    <a class="wordmark" href="/" aria-label="WidgetAI home">
      <LogoMark size={28} />
      <span>Widget<b>AI</b></span>
    </a>
    <div class="nf-body">
      <p class="nf-code" aria-hidden="true">404</p>
      <h1>Nothing here.</h1>
      <p class="nf-text">
        Not even the widget knows this page. It isn't in its context, and it
        won't make one up.
      </p>
      <div class="nf-acts">
        <a class="btn" href="/">Go home</a>
        <a class="btn-ghost" href={siteConfig.supportEmailHref}>Contact support</a>
      </div>
    </div>
  </main>
</Layout>

<style>
  .nf {
    min-height: 100svh;
    display: grid;
    grid-template-rows: auto 1fr;
    padding: 1.5rem var(--margin) 3rem;
  }
  .nf .wordmark {
    font-size: 17px;
    justify-self: start;
  }
  .nf-body {
    align-self: center;
    justify-self: center;
    width: min(640px, 100%);
  }
  .nf-code {
    font-size: clamp(120px, 22vw, 260px);
    font-weight: 800;
    letter-spacing: -0.07em;
    line-height: 0.85;
    color: var(--destructive);
  }
  .nf h1 {
    margin-top: 1.5rem;
    font-size: clamp(40px, 5vw, 72px);
    font-weight: 600;
    letter-spacing: -0.055em;
  }
  .nf-text {
    margin-top: 1rem;
    color: var(--muted-foreground);
    max-width: 44ch;
  }
  .nf-acts {
    margin-top: 1.8rem;
    display: flex;
    gap: 0.7rem;
    flex-wrap: wrap;
  }
</style>
