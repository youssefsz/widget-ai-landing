---
import { getImage, Image, Picture } from "astro:assets"
import Layout from "@/layouts/main.astro"
import LogoMark from "@/components/LogoMark.astro"
import heroImage from "@/assets/hero-sidi-bou-said.webp"
import darkSiteImage from "@/assets/example-dark-site.jpg"
import livePreviewImage from "@/assets/live-preview.jpg"
import { guideContextLines } from "@/lib/guide-context"
import {
  faqItems,
  getHomepageStructuredData,
  siteConfig,
  widgetConfig,
} from "@/lib/site"
import "@/styles/home.css"

const structuredData = getHomepageStructuredData(
  Astro.site ?? new URL(siteConfig.siteUrl)
)
const dashboard = widgetConfig.dashboardUrl
const heroSizes = "(max-width: 760px) calc(100vw - 40px), min(46vw, 760px)"
// Same transforms as the hero <Picture>, so the preload and the image share URLs.
const heroAvif = await getImage({
  src: heroImage,
  format: "avif",
  widths: [480, 760, 1100, 1448],
})
const shortWidgetId = `${widgetConfig.widgetId.slice(0, 12)}…`

// Answers in the conversation keep a little emphasis that the structured data omits.
const emphasis: Record<string, string[]> = {
  "How do I install it?": ["WordPress, Webflow, Shopify"],
  "What does it know about my business?": ["context and instructions"],
  "Can someone else put it on their site?": ["any other site are refused"],
  "Will it look like my site?": ["shadow DOM"],
  "Which AI does it use?": ["OpenRouter key"],
}
const escapeHtml = (text: string) =>
  text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
// One string, so no template whitespace ends up inside the <pre>.
const contextHtml = guideContextLines
  .map((line, index) => `<span data-l="${index}">${escapeHtml(line)}</span>`)
  .join("\n")
const answerHtml = (question: string, answer: string) => {
  let html = escapeHtml(answer).replace(
    "&lt;/body&gt;",
    "<code>&lt;/body&gt;</code>"
  )
  for (const phrase of emphasis[question] ?? []) {
    html = html.replace(phrase, `<b>${phrase}</b>`)
  }
  return html.replace(
    siteConfig.supportEmail,
    `<a href="${siteConfig.supportEmailHref}">${siteConfig.supportEmail}</a>`
  )
}
---

<Layout structuredData={structuredData}>
  <link
    slot="head"
    rel="preload"
    as="image"
    type="image/avif"
    imagesrcset={heroAvif.srcSet.attribute}
    imagesizes={heroSizes}
    fetchpriority="high"
  />
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="hero">
    <nav class="topbar" aria-label="Main">
      <a class="pill wordmark" href="/" aria-label="WidgetAI home">
        <LogoMark size={24} />
        <span>Widget<b>AI</b></span>
      </a>
      <a class="pill signin" href={dashboard}>Sign in</a>
    </nav>
    <div class="exhibit">
      <div class="stage">
        <div class="frame">
          <Picture
            src={heroImage}
            formats={["avif", "webp"]}
            fallbackFormat="jpg"
            widths={[480, 760, 1100, 1448]}
            sizes={heroSizes}
            alt="A whitewashed café terrace in Sidi Bou Said at night, lamps lit, the harbour glowing below"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <div class="talk" aria-hidden="true">
          <span class="chip q">Is breakfast included?</span>
          <span class="chip a"
            >Yes, breakfast is included in every rate and is served on the roof
            terrace from 7:30 to 10:30.</span
          >
        </div>
      </div>
      <h1>
        <span class="line"><span>Open after hours.</span></span>
      </h1>
      <div class="after">
        <p id="when">
          WidgetAI answers your visitors from what you've written down, whether
          or not anyone is at the desk.
        </p>
        <div class="acts">
          <a class="btn" href={dashboard}>Create your widget</a>
          <a class="link" href="#ask">Ask it something</a>
        </div>
      </div>
    </div>
  </header>
  <script is:inline>
    // Start the hero sequence once the photograph has loaded (never wait more than 2.5s).
    ;(function () {
      var ex = document.querySelector(".exhibit")
      var img = ex && ex.querySelector(".frame img")
      if (!ex || !img) return
      var go = function () {
        ex.classList.add("ready")
      }
      if (img.complete && img.naturalWidth) return go()
      img.addEventListener("load", go, { once: true })
      img.addEventListener("error", go, { once: true })
      setTimeout(go, 2500)
    })()
  </script>

  <main
    id="main"
    data-widget-api={widgetConfig.apiUrl}
    data-widget-id={widgetConfig.widgetId}
  >
    <section class="io" id="ask" aria-label="What it was given and what it says">
      <div class="in">
        <h2>What it was given</h2>
        <p class="sub">
          The full context of the widget on the right. Lines it uses light up.
        </p>
        <pre id="ctx" set:html={contextHtml} />
      </div>
      <div class="out">
        <h2>What it says</h2>
        <p class="sub">
          A real WidgetAI widget. Ask it anything; it can only use the text on
          the left.
        </p>
        <div class="chat">
          <div class="hd">
            <span class="av"><LogoMark size={20} /></span>WidgetAI guide
          </div>
          <div class="log" id="log" aria-live="polite">
            <div class="m u">Will it break my site's CSS?</div>
            <div class="m b">
              No. WidgetAI renders inside a shadow DOM, so your site's CSS won't
              affect the widget, and the widget's CSS won't affect your site.
            </div>
            <div class="m u">How much does it cost per month?</div>
            <div class="m b">
              The provided context doesn't include monthly pricing. Please
              contact {siteConfig.supportEmail} for current plan costs.
            </div>
          </div>
          <div class="pills">
            <button type="button" data-suggest>Do I need an SDK?</button>
            <button type="button" data-suggest>Can I use my own model?</button>
            <button type="button" data-suggest
              >Where does the launcher sit?</button
            >
          </div>
          <form id="chatForm">
            <label class="sr-only" for="msg">Message</label>
            <input
              id="msg"
              placeholder="Ask about WidgetAI"
              autocomplete="off"
              enterkeyhint="send"
              maxlength="4000"
            />
            <button class="send" type="submit" aria-label="Send">
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg
              >
            </button>
          </form>
        </div>
        <p class="note" id="note">
          The first two replies were recorded from this widget. New questions go
          to it live.
        </p>
      </div>
    </section>

    <section class="calls" aria-labelledby="calls-h">
      <div class="col">
        <h2 id="calls-h" data-reveal>Three things you hand over</h2>
        <div class="call" data-reveal>
          <p class="what">You give it a page of plain text about your business.</p>
          <div class="back">
            <p class="what">
              It gives back answers built from that text, and an honest "I don't
              know" for everything else.
            </p>
          </div>
        </div>
        <div class="call" data-reveal>
          <p class="what">You give it two colours and a corner.</p>
          <div class="back">
            <p class="what">
              It gives back a launcher that looks like it was always part of your
              site.
            </p>
          </div>
        </div>
        <div class="call" data-reveal>
          <p class="what">You give it one line of HTML, before &lt;/body&gt;.</p>
          <div class="back">
            <p class="what">
              It gives back the same assistant on every page, from the next page
              load.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="ex2" aria-labelledby="ex2-h">
      <figure data-reveal>
        <Picture
          src={darkSiteImage}
          formats={["avif", "webp"]}
          widths={[640, 960, 1280, 1920]}
          sizes="(max-width: 760px) calc(100vw - 40px), 64vw"
          alt="An example dark-themed API documentation site with a matching dark WidgetAI panel answering a question about rate limits"
          loading="lazy"
        />
      </figure>
      <div class="txt" data-reveal style="--i:1">
        <h2 id="ex2-h">Dark sites get a dark panel.</h2>
        <p>
          Set the panel background and the widget works out readable text
          colours for you. This is Ledgerly, an example API docs site, with its
          widget answering a rate-limit question at 2 a.m.
        </p>
      </div>
    </section>

    <section class="closeups" aria-labelledby="closeups-h">
      <div class="cu head" data-reveal>
        <h2 id="closeups-h">Small parts, up close</h2>
      </div>
      <div class="cu w6 h2" data-reveal style="--i:1">
        <div class="attr" aria-hidden="true">
          data-widget-id=<i>"{shortWidgetId}"</i>
        </div>
        <div class="cap">
          <b>One attribute</b><span
            >The tag only needs to know which widget it is.</span
          >
        </div>
      </div>
      <div class="cu w6 h3" data-reveal>
        <div class="tog" aria-hidden="true"></div>
        <div class="cap">
          <b>Domain lock</b><span
            >On: only the sites you list can use the widget.</span
          >
        </div>
      </div>
      <div class="cu w3 h3 half" data-reveal style="--i:1">
        <div class="code403" aria-hidden="true">403</div>
        <div class="cap">
          <b>Refused</b><span>What another site gets when it tries.</span>
        </div>
      </div>
      <div class="cu w3 h3 half pv" data-reveal style="--i:2">
        <Image
          class="preview-shot"
          src={livePreviewImage}
          widths={[240, 360, 480, 700]}
          sizes="(max-width: 760px) 30vw, 220px"
          alt="The live preview of a blue widget in the dashboard"
          loading="lazy"
        />
        <div class="cap">
          <b>Live preview</b><span>See it before you ship it.</span>
        </div>
      </div>
      <div class="cu w3 h2 half" data-reveal>
        <div class="sw" aria-hidden="true"></div>
        <span class="hex" aria-hidden="true">#a6e22e</span>
        <div class="cap"><b>Primary colour</b><span>Any hex value.</span></div>
      </div>
      <div class="cu w3 h2 half" data-reveal style="--i:1">
        <div class="dots" aria-hidden="true"><i></i><i></i><i></i></div>
        <div class="cap"><b>Thinking</b><span>Shown while it reads.</span></div>
      </div>
      <div class="cu w6 h2" data-reveal style="--i:2">
        <div class="model" aria-hidden="true">OpenRouter</div>
        <div class="cap">
          <b>Your own model</b><span
            >Bring a key, pick any model. Stored encrypted.</span
          >
        </div>
      </div>
      <div class="cu w6 h2" data-reveal>
        <div class="corners" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
        <div class="cap">
          <b>Four corners</b><span
            >Bottom right, 20px in, unless you say otherwise.</span
          >
        </div>
      </div>
      <a class="cu w6 h2 limecu" href={dashboard} data-reveal style="--i:1">
        <div class="cap">
          <b>All of it is set on one screen</b><span
            >Open the dashboard and try each part.</span
          >
        </div>
        <svg
          viewBox="0 0 48 48"
          fill="none"
          stroke="currentColor"
          stroke-width="3.5"
          aria-hidden="true"><path d="M12 36 36 12M18 12h18v18"></path></svg
        >
      </a>
    </section>

    <section class="faq" aria-labelledby="faq-h">
      <div class="lead-col">
        <h2 id="faq-h" data-reveal>The practical part</h2>
        <p data-reveal style="--i:1">
          What people ask before they paste the tag, answered the way the widget
          would answer it.
        </p>
        <div class="who" data-reveal style="--i:2">
          <span class="av"><LogoMark size={24} /></span>
          <span><b>WidgetAI guide</b>Answers from its context only</span>
        </div>
      </div>
      <dl class="thread">
        {
          faqItems.map(({ question, answer }) => (
            <Fragment>
              <dt class="ask" data-reveal>
                {question}
              </dt>
              <dd
                class="say"
                data-reveal
                style="--i:1"
                set:html={answerHtml(question, answer)}
              />
            </Fragment>
          ))
        }
      </dl>
    </section>

    <section class="close" aria-labelledby="close-h">
      <div class="card" data-reveal>
        <div>
          <h2 id="close-h">Write it down.<br /><span>It answers.</span></h2>
          <p>
            Put what your business knows into the dashboard tonight, paste your
            tag, and tomorrow your site answers its visitors on its own.
          </p>
          <div class="acts">
            <a class="btn" href={dashboard}>Create your widget</a>
            <a class="btn-ghost" href={siteConfig.supportEmailHref}
              >Ask Youssef first</a
            >
          </div>
        </div>
        <div class="install">
          <div class="bar">
            <span><b>This is the whole install</b></span>
            <button class="copy" type="button" id="copyTag">Copy</button>
          </div>
          <pre
            class="code"
            id="tag"><span class="t">&lt;script</span>
  <span class="a">src</span>=<span class="s">"{siteConfig.embedScriptUrl}"</span>
  <span class="a">data-widget-id</span>=<span class="s">"your-widget-id"</span>
<span class="t">&gt;&lt;/script&gt;</span></pre>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="top">
      <div class="brand">
        <a class="wordmark" href="/" aria-label="WidgetAI home">
          <LogoMark size={30} />
          <span>Widget<b>AI</b></span>
        </a>
        <p>
          An assistant for your website that answers from what you wrote, at any
          hour.
        </p>
      </div>
      <nav aria-labelledby="f-product">
        <h2 id="f-product">Product</h2>
        <ul>
          <li><a href="#ask">Ask it</a></li>
          <li><a href="#faq-h">The practical part</a></li>
          <li><a href="#close-h">Install</a></li>
        </ul>
      </nav>
      <nav aria-labelledby="f-account">
        <h2 id="f-account">Account</h2>
        <ul>
          <li><a href={dashboard}>Sign in</a></li>
          <li><a href={dashboard}>Dashboard</a></li>
        </ul>
      </nav>
      <nav aria-labelledby="f-contact">
        <h2 id="f-contact">Contact</h2>
        <ul>
          <li>
            <a href={siteConfig.supportEmailHref}>{siteConfig.supportEmail}</a>
          </li>
          <li><a href={siteConfig.privacyUrl}>Privacy</a></li>
          <li><a href={siteConfig.termsUrl}>Terms</a></li>
        </ul>
      </nav>
    </div>
    <div class="legal">
      <p>© 2026 WidgetAI, built by Youssef Dhibi.</p>
    </div>
    <div class="mark" aria-hidden="true"><span class="w"></span><span class="ai"></span></div>
  </footer>
</Layout>

<script>
  import "@/scripts/home"
</script>
