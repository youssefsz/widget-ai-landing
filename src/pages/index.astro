---
import { Image } from "astro:assets"
import Layout from "@/layouts/main.astro"
import Navbar from "@/components/Navbar.astro"
import FaqAccordion from "@/components/FaqAccordion.astro"
import LinkButton from "@/components/ui/LinkButton.astro"
import logoImage from "@/assets/logo.png"
import previewImage from "@/assets/preview.png"
import previewMobileImage from "@/assets/preview-mobile.png"
import widgetPreviewImage from "@/assets/widget-preview.png"
import { faqItems, getHomepageStructuredData, siteConfig } from "@/lib/site"
import "@/styles/pages/home.css"

const structuredData = getHomepageStructuredData(
  Astro.site ?? new URL(siteConfig.siteUrl)
)

const useCases = [
  {
    number: "01",
    title: "Customer support",
    description:
      "Answer account, policy, and setup questions from the context you provide.",
  },
  {
    number: "02",
    title: "Pre-sales",
    description: "Explain product fit, requirements, and setup.",
  },
  {
    number: "03",
    title: "Product guidance",
    description: "Guide visitors through features and installation.",
  },
] as const

const controlPoints = [
  {
    title: "Knowledge",
    description: "Add the business context used for answers.",
    detail: "Business context",
  },
  {
    title: "Instructions",
    description: "Define tone, behavior, and response style.",
    detail: "Response rules",
  },
  {
    title: "Appearance",
    description: "Choose colors, launcher position, and offsets.",
    detail: "Color and placement",
  },
  {
    title: "Domains",
    description: "Keep the widget public or restrict it to approved sites.",
    detail: "Public or restricted",
  },
  {
    title: "AI provider",
    description:
      "Use WidgetAI-managed AI or connect OpenRouter and select a model.",
    detail: "Managed or OpenRouter",
  },
] as const
---

<Layout
  title={siteConfig.defaultTitle}
  description={siteConfig.defaultDescription}
  keywords={siteConfig.defaultKeywords}
  structuredData={structuredData}
>
  <Navbar />

  <main class="home-page">
    <section class="hero-section relative overflow-hidden pt-16">
      <div
        class="mx-auto max-w-7xl px-5 pt-20 pb-12 sm:px-6 sm:pt-28 sm:pb-16 lg:px-8 lg:pt-32"
      >
        <div class="mb-7 flex items-center gap-3">
          <span class="h-px w-8 bg-primary" aria-hidden="true"></span>
          <p
            class="text-[0.68rem] font-semibold tracking-[0.18em] text-primary uppercase"
          >
            AI answers, embedded on your site
          </p>
        </div>

        <div class="grid items-end gap-9 lg:grid-cols-12 lg:gap-8">
          <div class="lg:col-span-8">
            <h1
              class="max-w-5xl text-[clamp(3.3rem,7vw,6.85rem)] leading-[0.91] font-semibold tracking-[-0.065em] text-balance text-foreground"
            >
              Your website can answer for itself.
            </h1>
          </div>

          <div class="lg:col-span-4 lg:pb-2">
            <p
              class="max-w-xl text-base leading-7 text-muted-foreground sm:text-lg sm:leading-8"
            >
              Turn your business context into a branded assistant for product,
              sales, and support questions, then ship it with one script tag.
            </p>

            <div class="mt-7 grid gap-3 sm:flex lg:grid">
              <LinkButton href={siteConfig.dashboardUrl} size="lg">
                Create your widget
                <svg
                  aria-hidden="true"
                  viewBox="0 0 16 16"
                  fill="none"
                  class="h-4 w-4"
                >
                  <path
                    d="M3.5 8h9m-3.25-3.25L12.5 8l-3.25 3.25"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
                </svg>
              </LinkButton>
              <LinkButton href="#how-it-works" variant="outline" size="lg">
                See how it works
              </LinkButton>
            </div>
          </div>
        </div>

        <div
          id="product"
          class="product-frame relative mt-14 scroll-mt-24 overflow-hidden border-y border-border/75 sm:mt-20"
        >
          <div
            class="flex h-11 items-center justify-between border-b border-border/60 bg-background/72 px-4 sm:h-12 sm:px-5"
          >
            <div class="flex items-center gap-1.5" aria-hidden="true">
              <span class="h-2 w-2 rounded-full bg-muted-foreground/35"></span>
              <span class="h-2 w-2 rounded-full bg-muted-foreground/25"></span>
              <span class="h-2 w-2 rounded-full bg-primary/70"></span>
            </div>
            <div
              class="hidden items-center gap-2 font-mono text-[0.66rem] tracking-wide text-muted-foreground sm:flex"
            >
              <span class="h-1.5 w-1.5 rounded-full bg-primary"></span>
              dashboard.widgetai.youssef.tn
            </div>
            <span
              class="font-mono text-[0.62rem] tracking-[0.14em] text-muted-foreground uppercase"
            >
              Dashboard preview
            </span>
          </div>

          <figure
            class="relative h-[34rem] overflow-hidden sm:aspect-[1.98/1] sm:h-auto"
          >
            <picture class="block h-full w-full">
              <source
                media="(max-width: 639px)"
                srcset={previewMobileImage.src}
              />
              <Image
                src={previewImage}
                alt="WidgetAI dashboard showing configured website assistants and an embed snippet"
                loading="eager"
                fetchpriority="high"
                widths={[800, 1200, 1600, 2200]}
                sizes="(max-width: 1280px) 100vw, 1216px"
                class="h-full w-full object-cover object-top"
              />
            </picture>

            <div
              class="pointer-events-none absolute inset-x-0 bottom-0 hidden h-28 bg-gradient-to-t from-background/75 to-transparent sm:block"
              aria-hidden="true"
            >
            </div>

            <figcaption class="sr-only">
              WidgetAI dashboard for configuring and installing website
              assistants.
            </figcaption>
          </figure>
        </div>

        <dl
          class="mt-8 grid border-y border-border/55 sm:grid-cols-2 lg:mt-10 lg:grid-cols-4"
        >
          <div class="py-5 sm:col-span-2 sm:pr-8 lg:col-span-1">
            <dt
              class="font-mono text-[0.65rem] tracking-[0.14em] text-primary uppercase"
            >
              Built for the web you have
            </dt>
            <dd class="mt-2 max-w-xs text-sm leading-6 text-muted-foreground">
              Product proof, not a concept mockup.
            </dd>
          </div>
          <div
            class="border-t border-border/55 py-5 sm:border-t-0 sm:border-l sm:pl-6"
          >
            <dt class="text-sm font-semibold text-foreground">No SDK</dt>
            <dd class="mt-1 text-sm text-muted-foreground">One script tag</dd>
          </div>
          <div
            class="border-t border-border/55 py-5 sm:border-l sm:pl-6 lg:border-t-0"
          >
            <dt class="text-sm font-semibold text-foreground">Any stack</dt>
            <dd class="mt-1 text-sm text-muted-foreground">Plain web embed</dd>
          </div>
          <div
            class="border-t border-border/55 py-5 sm:border-l sm:pl-6 lg:border-t-0"
          >
            <dt class="text-sm font-semibold text-foreground">Your rules</dt>
            <dd class="mt-1 text-sm text-muted-foreground">
              Context and domains
            </dd>
          </div>
        </dl>
      </div>
    </section>

    <section class="border-t border-border/50 py-16">
      <div
        class="mx-auto grid max-w-7xl gap-12 px-5 sm:px-6 lg:grid-cols-12 lg:gap-12 lg:px-8"
      >
        <div class="lg:col-span-4">
          <p class="section-kicker">Use cases</p>
          <h2 class="section-title mt-5 max-w-lg">
            Give each question a focused assistant.
          </h2>
          <p class="mt-6 max-w-md text-base leading-7 text-muted-foreground">
            Create separate widgets for support, pre-sales, or product guidance.
            Each widget can use its own context and instructions.
          </p>
        </div>

        <div class="border-t border-border/55 lg:col-span-7 lg:col-start-6">
          {
            useCases.map((useCase) => (
              <article class="grid gap-3 border-b border-border/55 py-7 sm:grid-cols-[2.5rem_10rem_1fr] sm:items-start sm:gap-6 sm:py-8">
                <span class="font-mono text-[0.66rem] tracking-[0.14em] text-primary">
                  {useCase.number}
                </span>
                <h3 class="text-base font-semibold tracking-tight text-foreground sm:text-lg">
                  {useCase.title}
                </h3>
                <p class="max-w-xl text-sm leading-6 text-muted-foreground sm:text-base sm:leading-7">
                  {useCase.description}
                </p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section
      id="how-it-works"
      class="scroll-mt-20 border-t border-border/50 py-16"
    >
      <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
        <div class="grid gap-8 lg:grid-cols-12 lg:gap-12">
          <div class="lg:col-span-6">
            <p class="section-kicker">Setup</p>
            <h2 class="section-title mt-5 max-w-2xl">
              From business context to a live widget.
            </h2>
          </div>
          <div class="lg:col-span-5 lg:col-start-8 lg:pt-7">
            <p class="section-copy">
              Add what the assistant should know, match it to your site, then
              copy the generated script tag.
            </p>
          </div>
        </div>

        <div class="mt-14 border-t border-border/55 sm:mt-16">
          <article
            class="workflow-row grid min-w-0 gap-10 py-10 sm:py-12 lg:grid-cols-12 lg:gap-12 lg:py-16"
          >
            <div class="lg:col-span-4">
              <span class="step-number">01 / Context</span>
              <h3
                class="mt-6 text-2xl font-semibold tracking-tight text-foreground sm:text-3xl"
              >
                Add the knowledge and rules.
              </h3>
              <p
                class="mt-5 max-w-md text-base leading-7 text-muted-foreground"
              >
                Provide the business context for this widget. Add instructions
                for tone, behavior, and how to handle questions that the context
                does not answer.
              </p>
            </div>

            <div
              class="min-w-0 border-t border-border/55 lg:col-span-7 lg:col-start-6 lg:border-t-0 lg:border-l lg:pl-10"
            >
              <div
                class="flex items-center justify-between border-b border-border/55 py-4"
              >
                <span class="text-xs font-semibold text-foreground"
                  >Widget knowledge</span
                >
                <span
                  class="flex items-center gap-2 text-xs text-muted-foreground"
                >
                  <span class="h-1.5 w-1.5 rounded-full bg-primary"></span>
                  Saved
                </span>
              </div>
              <div class="grid sm:grid-cols-2">
                <div
                  class="border-b border-border/55 py-6 sm:border-r sm:border-b-0 sm:pr-8"
                >
                  <p class="ui-label">Business context</p>
                  <div
                    class="mt-4 space-y-3 text-sm leading-6 text-muted-foreground"
                  >
                    <p class="text-foreground">
                      WidgetAI helps websites answer visitor questions.
                    </p>
                    <p>
                      Each assistant uses the business knowledge configured for
                      that widget.
                    </p>
                    <p>Installation uses a generated JavaScript embed tag.</p>
                  </div>
                </div>
                <div class="py-6 sm:pl-8">
                  <p class="ui-label">Instructions</p>
                  <ul
                    class="mt-4 space-y-4 text-sm leading-6 text-muted-foreground"
                  >
                    <li class="flex gap-3">
                      <span
                        class="mt-2.5 h-1 w-1 shrink-0 rounded-full bg-primary"
                      ></span>
                      Be concise and direct.
                    </li>
                    <li class="flex gap-3">
                      <span
                        class="mt-2.5 h-1 w-1 shrink-0 rounded-full bg-primary"
                      ></span>
                      Use only the supplied context.
                    </li>
                    <li class="flex gap-3">
                      <span
                        class="mt-2.5 h-1 w-1 shrink-0 rounded-full bg-primary"
                      ></span>
                      Say when an answer is unknown.
                    </li>
                  </ul>
                </div>
              </div>
            </div>
          </article>

          <article
            class="workflow-row grid min-w-0 gap-10 py-10 sm:py-12 lg:grid-cols-12 lg:gap-12 lg:py-16"
          >
            <div class="lg:col-span-4">
              <span class="step-number">02 / Appearance</span>
              <h3
                class="mt-6 text-2xl font-semibold tracking-tight text-foreground sm:text-3xl"
              >
                Match the widget to your site.
              </h3>
              <p
                class="mt-5 max-w-md text-base leading-7 text-muted-foreground"
              >
                Choose the primary color, panel background, launcher position,
                and offsets.
              </p>
            </div>

            <div
              class="min-w-0 border-t border-border/55 lg:col-span-7 lg:col-start-6 lg:border-t-0 lg:border-l lg:pl-10"
            >
              <div class="grid sm:grid-cols-[0.72fr_1.28fr]">
                <dl class="border-y border-border/55 sm:self-center">
                  <div class="setting-row">
                    <dt>Primary color</dt>
                    <dd class="flex items-center gap-2">
                      <span class="h-3.5 w-3.5 rounded-sm bg-primary"></span>
                      Lime
                    </dd>
                  </div>
                  <div class="setting-row">
                    <dt>Panel</dt>
                    <dd>Light</dd>
                  </div>
                  <div class="setting-row">
                    <dt>Launcher</dt>
                    <dd>Bottom right</dd>
                  </div>
                  <div class="setting-row">
                    <dt>Offsets</dt>
                    <dd>24px / 24px</dd>
                  </div>
                </dl>
                <div
                  class="flex items-center justify-center pt-8 sm:border-l sm:border-border/55 sm:pt-0 sm:pl-10"
                >
                  <Image
                    src={widgetPreviewImage}
                    alt="Preview of WidgetAI with lime brand styling"
                    loading="lazy"
                    widths={[240, 320, 480]}
                    sizes="(max-width: 640px) 68vw, 260px"
                    class="w-full max-w-[16rem]"
                  />
                </div>
              </div>
            </div>
          </article>

          <article
            class="workflow-row grid min-w-0 gap-10 py-10 sm:py-12 lg:grid-cols-12 lg:gap-12 lg:py-16"
          >
            <div class="lg:col-span-4">
              <span class="step-number">03 / Install</span>
              <h3
                class="mt-6 text-2xl font-semibold tracking-tight text-foreground sm:text-3xl"
              >
                Copy the generated script tag.
              </h3>
              <p
                class="mt-5 max-w-md text-base leading-7 text-muted-foreground"
              >
                Paste the JavaScript tag into your site. The embed works
                independently of your frontend framework.
              </p>
            </div>

            <div
              class="min-w-0 border-t border-border/55 lg:col-span-7 lg:col-start-6 lg:border-t-0 lg:border-l lg:pl-10"
            >
              <div
                class="flex items-center justify-between border-b border-border/55 py-4"
              >
                <span class="text-xs font-semibold text-foreground"
                  >Install widget</span
                >
                <span
                  class="font-mono text-[0.62rem] tracking-[0.12em] text-primary uppercase"
                  >Ready to embed</span
                >
              </div>
              <div
                class="max-w-full min-w-0 overflow-x-auto border-b border-border/55 py-7 pl-5 [border-left:2px_solid_var(--primary)]"
              >
                <pre
                  class="min-w-[29rem] font-mono text-[0.7rem] leading-6 sm:text-xs"><code><span class="text-muted-foreground">&lt;</span><span class="text-[#7db7ff]">script</span>
  <span class="text-[#b8d7ff]">src</span><span class="text-muted-foreground">=</span><span class="text-[#d5ee94]">"{siteConfig.embedScriptUrl}"</span>
  <span class="text-[#b8d7ff]">data-widget-id</span><span class="text-muted-foreground">=</span><span class="text-[#d5ee94]">"widget_xxxxxxxx"</span>
<span class="text-muted-foreground">&gt;&lt;/</span><span class="text-[#7db7ff]">script</span><span class="text-muted-foreground">&gt;</span></code></pre>
              </div>
              <dl class="grid border-b border-border/55 sm:grid-cols-2">
                <div class="py-5 sm:pr-8">
                  <dt class="ui-label">Approved domain</dt>
                  <dd class="mt-2 text-sm font-medium text-foreground">
                    widgetai.youssef.tn
                  </dd>
                </div>
                <div
                  class="border-t border-border/55 py-5 sm:border-t-0 sm:border-l sm:pl-8"
                >
                  <dt class="ui-label">Widget status</dt>
                  <dd
                    class="mt-2 flex items-center gap-2 text-sm font-medium text-foreground"
                  >
                    <span class="h-1.5 w-1.5 rounded-full bg-primary"></span>
                    Public
                  </dd>
                </div>
              </dl>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section id="features" class="scroll-mt-20 border-y border-border/50 py-16">
      <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
        <div class="grid gap-8 lg:grid-cols-12 lg:gap-12">
          <div class="lg:col-span-6">
            <p class="section-kicker">Widget settings</p>
            <h2 class="section-title mt-5 max-w-2xl">
              Control each widget directly.
            </h2>
          </div>
          <div class="lg:col-span-5 lg:col-start-8 lg:pt-7">
            <p class="section-copy">
              Set its knowledge, instructions, appearance, domain access, and AI
              provider from the dashboard.
            </p>
          </div>
        </div>

        <div class="mt-14 border-t border-border/55 sm:mt-16">
          {
            controlPoints.map((point, index) => (
              <article class="grid gap-3 border-b border-border/55 py-7 sm:py-8 lg:grid-cols-12 lg:items-start lg:gap-8">
                <span class="font-mono text-[0.65rem] text-primary lg:col-span-1">
                  0{index + 1}
                </span>
                <h3 class="text-lg font-semibold tracking-tight text-foreground lg:col-span-3">
                  {point.title}
                </h3>
                <p class="max-w-xl text-sm leading-6 text-muted-foreground sm:text-base sm:leading-7 lg:col-span-5">
                  {point.description}
                </p>
                <span class="font-mono text-[0.65rem] tracking-wide text-muted-foreground lg:col-span-3 lg:text-right">
                  {point.detail}
                </span>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section id="faq" class="scroll-mt-20 py-16">
      <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
        <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-4">
            <p class="section-kicker">FAQ</p>
            <h2 class="section-title mt-5">
              Straight answers before you add the tag.
            </h2>
            <p
              class="mt-6 max-w-sm text-sm leading-6 text-muted-foreground sm:text-base sm:leading-7"
            >
              Need something more specific? Email us and we’ll help you decide
              whether WidgetAI fits your site.
            </p>
            <a
              href={siteConfig.supportEmailHref}
              class="mt-6 inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-primary underline-offset-4 hover:underline"
            >
              Contact support
              <svg
                aria-hidden="true"
                viewBox="0 0 16 16"
                fill="none"
                class="h-3.5 w-3.5"
              >
                <path
                  d="M3.5 8h9m-3.25-3.25L12.5 8l-3.25 3.25"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </a>
          </div>

          <FaqAccordion items={faqItems} />
        </div>
      </div>
    </section>

    <section class="pb-12 sm:pb-16">
      <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
        <div
          class="cta-panel relative overflow-hidden rounded-2xl bg-primary px-6 py-12 text-primary-foreground sm:px-10 sm:py-16 lg:px-14 lg:py-20"
        >
          <div class="relative z-10 grid items-end gap-10 lg:grid-cols-12">
            <div class="lg:col-span-8">
              <p
                class="font-mono text-[0.66rem] font-semibold tracking-[0.16em] uppercase opacity-65"
              >
                Your context. Your rules. Your website.
              </p>
              <h2
                class="mt-5 max-w-4xl text-4xl leading-[0.98] font-semibold tracking-[-0.05em] text-balance sm:text-5xl lg:text-7xl"
              >
                Put a useful assistant on your site.
              </h2>
            </div>
            <div class="lg:col-span-4">
              <p
                class="max-w-md text-sm leading-6 opacity-70 sm:text-base sm:leading-7"
              >
                Create the widget, add your business context, and ship it with
                one tag.
              </p>
              <LinkButton
                href={siteConfig.dashboardUrl}
                variant="inverse"
                size="lg"
                class="mt-7 w-full sm:w-auto"
              >
                Create your widget
                <svg
                  aria-hidden="true"
                  viewBox="0 0 16 16"
                  fill="none"
                  class="h-4 w-4"
                >
                  <path
                    d="M3.5 8h9m-3.25-3.25L12.5 8l-3.25 3.25"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
                </svg>
              </LinkButton>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer border-t border-border/50 py-10 sm:py-12">
    <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
      <div class="grid gap-10 md:grid-cols-[1fr_auto] md:items-start">
        <div>
          <a
            href="/"
            aria-label="WidgetAI home"
            class="inline-flex min-h-11 items-center rounded-sm outline-none focus-visible:ring-2 focus-visible:ring-primary"
          >
            <Image
              src={logoImage}
              alt="WidgetAI"
              width={154}
              height={40}
              class="h-7 w-auto"
            />
          </a>
          <p class="mt-4 max-w-md text-sm leading-6 text-muted-foreground">
            Turn the business context you provide into an AI assistant embedded
            on your website.
          </p>
        </div>

        <nav
          class="grid grid-cols-2 gap-x-12 gap-y-3 text-sm text-muted-foreground sm:grid-cols-3"
          aria-label="Footer navigation"
        >
          <a class="footer-link" href="#product">Product</a>
          <a class="footer-link" href="#how-it-works">How it works</a>
          <a class="footer-link" href="#features">Control</a>
          <a class="footer-link" href="#faq">FAQ</a>
          <a class="footer-link" href={siteConfig.privacyUrl}>Privacy</a>
          <a class="footer-link" href={siteConfig.termsUrl}>Terms</a>
        </nav>
      </div>

      <div
        class="mt-10 flex flex-col gap-3 border-t border-border/50 pt-6 text-xs text-muted-foreground sm:flex-row sm:items-center sm:justify-between"
      >
        <p>&copy; {new Date().getFullYear()} WidgetAI.</p>
        <a class="footer-link" href={siteConfig.supportEmailHref}
          >{siteConfig.supportEmail}</a
        >
      </div>
    </div>
  </footer>
